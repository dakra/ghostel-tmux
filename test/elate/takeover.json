{
  "name": "takeover",
  "comment": "`tmux -CC' typed in a ghostel shell, from takeover to every way of leaving it. One variant per host shell x PTY path; the panes run the same shell.",
  "variants": {
    "bash-native": {"shell": "/opt/homebrew/bin/bash", "native": "t", "wrapper": "bash"},
    "bash-emacs-pty": {"shell": "/opt/homebrew/bin/bash", "native": "nil", "wrapper": "bash"},
    "zsh-native": {"shell": "/bin/zsh", "native": "t", "wrapper": "zsh"},
    "zsh-emacs-pty": {"shell": "/bin/zsh", "native": "nil", "wrapper": "zsh"},
    "fish-native": {"shell": "/opt/homebrew/bin/fish", "native": "t", "wrapper": "fish"},
    "fish-emacs-pty": {"shell": "/opt/homebrew/bin/fish", "native": "nil", "wrapper": "fish"},
    "nu-native": {"shell": "/opt/homebrew/bin/nu", "native": "t", "wrapper": "nu"},
    "nu-emacs-pty": {"shell": "/opt/homebrew/bin/nu", "native": "nil", "wrapper": "nu"},
    "bash3-native": {"shell": "/bin/bash", "native": "t", "wrapper": "bash"},
    "bash3-emacs-pty": {"shell": "/bin/bash", "native": "nil", "wrapper": "bash"}
  },
  "session": {
    "ui": "tty",
    "size": "120x36",
    "config": "minimal",
    "env": {"SHELL": "{{shell}}"},
    "load": ["lib/ghostel-tmux-setup.el"],
    "eval": [
      "(elate-tmux-init \"takeover-{{variant}}\" \"{{shell}}\" {{native}})",
      "(ghostel-tmux-takeover-mode 1)"
    ]
  },
  "defaults": {"timeout": 20},
  "steps": [
    {"eval": "(ghostel)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "takeover", "comment": "the shell's buffer hides itself and the first pane takes its window, at the window's size"},
    {"type": "tmux -CC new -s t1"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"assert": {"eval": "(string-prefix-p \" *ghostel-tmux-host:\" (buffer-name (elate-tmux-host)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (list (elate-tmux-id)))"}},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{session_name}\" (elate-tmux-session)) \"t1\")"}},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "flood", "comment": "no line is lost or split inside a character, and the pane answers afterwards; it comes first because tmux keeps 2000 lines for the re-attach below"},
    {"type": "sh -c 'seq 1 30000'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"30000\")", "timeout": 60},
    {"type": "sh -c 'i=0; while [ $i -lt 5000 ]; do echo \"FL: héllo × wörld $i\"; i=$((i+1)); done'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"FL: héllo × wörld 4999\")", "timeout": 90},
    {"assert": {"eval": "(save-excursion (goto-char (point-min)) (let ((n 0)) (while (re-search-forward \"^FL:.*$\" nil t) (unless (string-match-p \"\\\\`FL: héllo × wörld [0-9]+ *\\\\'\" (match-string 0)) (error \"Mangled line: %S\" (match-string 0))) (setq n (1+ n))) (and (> n 1000) (not (string-search \"\\ufffd\" (elate-tmux-text))))))"}},
    {"type": "printf 'FL%sOOD-OK\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"FLOOD-OK\")"},

    {"group": "output", "comment": "UTF-8 (0xC3 0x97 = ×, whose second byte is a C1 code) and SGR reach the pane"},
    {"type": "printf 'héllo × wörld\\n'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"héllo × wörld\")"},
    {"type": "printf '\\033[31mRED\\033[0m ok\\n'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"RED ok\")"},
    {"assert": {"eval": "(save-excursion (goto-char (point-min)) (re-search-forward \"^RED ok\") (get-text-property (match-beginning 0) (quote face)))"}},

    {"group": "wide output", "comment": "double-width characters"},
    {"type": "printf '日本語 漢字 🎉 ok\\n'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"日本語 漢字 🎉 ok\")"},

    {"group": "resize", "comment": "the pane's Emacs window is the size tmux gets"},
    {"eval": "(set-window-buffer (split-window (selected-window) 12) (get-buffer-create \"*other*\"))"},
    {"wait": "until", "pred": "(< ghostel--term-rows 20)"},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"eval": "(delete-other-windows)"},
    {"wait": "until", "pred": "(> ghostel--term-rows 20)"},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},

    {"group": "detach", "comment": "the shell comes back, the pane stays as a read-only snapshot, the session lives on"},
    {"eval": "(setq elate-old (current-buffer))"},
    {"keys": "C-c C-d"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))"},
    {"assert": {"eval": "(with-current-buffer elate-old (and buffer-read-only (null ghostel-pty-out-function)))"}},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"t1\") \"0\")"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'BA%sCK-OK\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"BACK-OK\")"},
    {"assert": {"eval": "(not (string-match-p \"refresh-client\\\\|send-keys\\\\|select-pane\" (elate-tmux-text)))"}, "comment": "no control-mode command reached the shell"},

    {"group": "re-attach", "comment": "the backfill restores the content, colors included; the old snapshot stays disconnected"},
    {"type": "tmux -CC attach -t t1"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"FLOOD-OK\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"RED ok\")"}},
    {"assert": {"eval": "(save-excursion (goto-char (point-min)) (re-search-forward \"^RED ok\") (get-text-property (match-beginning 0) (quote face)))"}},
    {"assert": {"eval": "(elate-tmux-line-p \"héllo × wörld\")"}},
    {"assert": {"eval": "(elate-tmux-line-p \"日本語 漢字 🎉 ok\")"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'AT%sTACHED\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"ATTACHED\")"},
    {"assert": {"eval": "(with-current-buffer elate-old (condition-case nil (progn (call-interactively (key-binding (kbd \"C-t c\"))) nil) (user-error t)))"}},
    {"wait": "idle"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{session_windows}\" \"t1\") \"1\")"}},

    {"group": "reset", "comment": "M-x ghostel-tmux-reset gives the shell back"},
    {"keys": "M-x ghostel-tmux-reset RET"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"t1\") \"0\")"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'AF%sTER-OK\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"AFTER-OK\")"},

    {"group": "mode off", "comment": "without the mode `tmux -CC' shows nothing; RET makes tmux leave"},
    {"eval": "(ghostel-tmux-takeover-mode -1)"},
    {"type": "tmux -CC attach -t t1"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"t1\") \"1\")"},
    {"wait": "idle"},
    {"assert": {"eval": "(and (null (elate-tmux-panes)) (null (elate-tmux-host)))"}},
    {"assert": {"eval": "(not (string-match-p \"%begin\\\\|%session-changed\\\\|%output\" (elate-tmux-text)))"}},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"t1\") \"0\")"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'MO%sDE-OFF\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"MODE-OFF\")"},
    {"eval": "(ghostel-tmux-takeover-mode 1)"},

    {"group": "shell wrapper", "comment": "with shell/ghostel-tmux.* sourced, plain `tmux attach' is taken over"},
    {"eval": "(ghostel-send-string (format \"source %s\\n\" (elate-tmux-wrapper \"{{wrapper}}\")))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "tmux attach -t t1"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "session ends", "comment": "`exit' in the last pane ends the session and the server"},
    {"type": "exit"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))"},
    {"wait": "until", "pred": "(not (elate-tmux-server-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'EN%sDED-OK\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"ENDED-OK\")"},

    {"group": "server killed", "comment": "the shell comes back"},
    {"type": "tmux new -s t2"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"eval": "(elate-tmux-call \"kill-server\")"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'SR%sV-DEAD\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"SRV-DEAD\")"},

    {"group": "host shell dies", "comment": "the panes are sealed"},
    {"type": "tmux new -s t3"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"eval": "(elate-tmux-kill (elate-tmux-parent-pid (elate-tmux-client-pid)))"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(with-current-buffer (window-buffer) (and ghostel-tmux-pane-mode buffer-read-only))"}},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"t3\") \"0\")"},

    {"group": "client killed", "comment": "the frame ends with the shell's next escape sequence: its prompt, or C-l after M-x ghostel-tmux-reset"},
    {"eval": "(ghostel)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "tmux -CC attach -t t3"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"eval": "(elate-tmux-kill (elate-tmux-client-pid))"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))", "timeout": 5, "xfail": {"bash3-native": "bash 3.2 loads no shell integration, so its prompt has no escape sequence that would end the frame", "bash3-emacs-pty": "bash 3.2 loads no shell integration, so its prompt has no escape sequence that would end the frame"}},
    {"eval": "(elate-tmux-reset-if-attached)"},
    {"keys": "C-l"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (eq (window-buffer) (get-buffer \"*ghostel*\")))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'CL%sI-DEAD\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"CLI-DEAD\")", "timeout": 8, "xfail": {"nu-emacs-pty": "nushell exits on its next read: the killed tmux left the tty non-blocking"}},

    {"group": "cleanup", "comment": "no server is left"},
    {"assert": {"eval": "(elate-tmux-cleanup)"}}
  ]
}
