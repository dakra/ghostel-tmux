{
  "name": "panes",
  "comment": "Working in a tmux session by keyboard and mouse, one pane per Emacs window (`ghostel-tmux-split-windows' off): typing, splits, switching, windows, a full-screen program, scrollback, a second client, closing, leaving. The variants differ in how the session is entered: `params' is the takeover from a shell, `new' overrides it with M-x ghostel-tmux-new.",
  "params": {
    "enter": "(ghostel)",
    "ready": "(elate-tmux-prompt-p)",
    "attach": "(ghostel-send-string \"tmux -CC new -s p1\\n\")",
    "left": "(with-current-buffer \"*ghostel*\" (not (string-match-p \"refresh-client\\\\|send-keys\\\\|select-pane\" (elate-tmux-text))))"
  },
  "variants": {
    "bash-native": {"shell": "/opt/homebrew/bin/bash", "native": "t"},
    "bash-emacs-pty": {"shell": "/opt/homebrew/bin/bash", "native": "nil"},
    "zsh": {"shell": "/bin/zsh", "native": "t"},
    "fish": {"shell": "/opt/homebrew/bin/fish", "native": "t"},
    "new": {"shell": "/opt/homebrew/bin/bash", "native": "t", "enter": "(ignore)", "ready": "t", "attach": "(ghostel-tmux-new \"p1\")", "left": "(null (elate-tmux-controllers))"}
  },
  "session": {
    "ui": "tty",
    "size": "120x36",
    "config": "minimal",
    "env": {"SHELL": "{{shell}}"},
    "load": ["lib/ghostel-tmux-setup.el"],
    "eval": [
      "(elate-tmux-init \"panes-{{variant}}\" \"{{shell}}\" {{native}})",
      "(setq ghostel-tmux-split-windows nil)",
      "(ghostel-tmux-takeover-mode 1)"
    ]
  },
  "defaults": {"timeout": 20},
  "steps": [
    {"eval": "{{enter}}"},
    {"wait": "until", "pred": "{{ready}}"},
    {"eval": "{{attach}}", "timeout": 30},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"eval": "(setq elate-p0 (current-buffer))"},

    {"group": "typing", "comment": "keys, an interrupt, history, a paste and the literal prefix reach the pane's program"},
    {"type": "printf 'TY%sPE1\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"TYPE1\")"},
    {"assert": {"eval": "(not buffer-read-only)"}, "comment": "an Emacs input method composes only in a buffer that takes edits"},
    {"keys": "<up> RET"},
    {"wait": "until", "pred": "(= 2 (how-many \"^TYPE1 *$\" (point-min) (point-max)))"},
    {"type": "cat"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{pane_current_command}\" (elate-tmux-id)) \"cat\")"},
    {"keys": "C-c C-c"},
    {"wait": "until", "pred": "(not (equal (elate-tmux-q \"#{pane_current_command}\" (elate-tmux-id)) \"cat\"))"},
    {"eval": "(kill-new (concat (mapconcat (lambda (i) (format \"line %03d %s\" i (make-string 50 ?x))) (number-sequence 1 34) \"\\n\") \"\\n\"))", "comment": "2 KB: four send-keys chunks"},
    {"type": "sh -c 'cat > /tmp/ghostel-tmux-elate-panes-{{variant}}/paste.txt'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(and (file-exists-p \"/tmp/ghostel-tmux-elate-panes-{{variant}}/paste.txt\") (not (ghostel--mode-enabled ghostel--term 2004)))", "comment": "cat runs and the shell's bracketed paste is off"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(equal (with-temp-buffer (insert-file-contents \"/tmp/ghostel-tmux-elate-panes-{{variant}}/paste.txt\") (buffer-string)) (car kill-ring))"},
    {"keys": "C-d"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "sh -c 'stty raw; printf \"RA%sW\" \"\"; dd bs=1 count=1 2>/dev/null | od -An -b; stty sane'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(string-match-p \"^RAW\" (elate-tmux-text))"},
    {"keys": "C-t C-t"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"RAW *024\")"},

    {"group": "splits", "comment": "the new pane takes the window and the keys"},
    {"keys": "C-t \""},
    {"wait": "until", "pred": "(= 2 (length (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-p0))) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"assert": {"eval": "(= 1 (length (window-list)))"}},
    {"eval": "(setq elate-p1 (current-buffer))"},
    {"type": "sh -c 'echo PANE$TMUX_PANE'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p (concat \"PANE\" (elate-tmux-id)))"},
    {"keys": "C-t %"},
    {"wait": "until", "pred": "(= 3 (length (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-p0 elate-p1))) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"eval": "(setq elate-p2 (current-buffer))"},
    {"type": "sh -c 'echo PANE$TMUX_PANE'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p (concat \"PANE\" (elate-tmux-id)))"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_panes}\" (elate-tmux-id)) \"3\")"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (mapcar (function elate-tmux-id) (list elate-p0 elate-p1 elate-p2)))"}},

    {"group": "switching", "comment": "prefix keys, the picker and a tab click; tmux's active pane follows each"},
    {"keys": "C-t o"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},
    {"keys": "C-t C-n"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p1) (elate-tmux-sync-p))"},
    {"keys": "C-t C-p"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},
    {"keys": "C-t s", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"Pane: \")"},
    {"eval": "(insert (buffer-name elate-p2))", "buffer": " *Minibuf-1*"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p2) (elate-tmux-sync-p))"},
    {"mouse": "click", "part": "tab-line", "col": 5},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},

    {"group": "zoom", "comment": "the pane shown is zoomed in tmux, also after a pane joins the window without being selected or another one leaves it"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\")"},
    {"eval": "(progn (setq elate-extra (elate-tmux-call \"split-window\" \"-d\" \"-P\" \"-F\" \"#{pane_id}\" \"-t\" (elate-tmux-id))) (setq elate-extra (string-trim elate-extra)) t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\") (elate-tmux-sync-p))"},
    {"eval": "(progn (elate-tmux-call \"kill-pane\" \"-t\" elate-extra) t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_panes}\" (elate-tmux-id)) \"3\") (equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\") (elate-tmux-sync-p))"},

    {"eval": "(progn (set-window-buffer (split-window-right) elate-p1) t)", "comment": "a second Emacs window shows a sibling, which tmux then has active"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{pane_id}\" (elate-tmux-session)) (elate-tmux-id elate-p1)) (equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\"))"},
    {"eval": "(progn (elate-tmux-call \"select-pane\" \"-t\" (elate-tmux-id elate-p0)) t)", "comment": "a selection of a pane already shown stands and is zoomed"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{pane_id}\" (elate-tmux-session)) (elate-tmux-id elate-p0)) (equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\"))"},
    {"eval": "(progn (delete-other-windows) t)"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},

    {"group": "windows", "comment": "new, next, previous, by number, renames, a free command, and switching across windows"},
    {"keys": "C-t c"},
    {"wait": "until", "pred": "(= 4 (length (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-p0 elate-p1 elate-p2))) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"eval": "(setq elate-p3 (current-buffer))"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_index}\" (elate-tmux-id)) \"1\")"}},
    {"keys": "C-t p"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},
    {"keys": "C-t 0"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},
    {"keys": "C-t ,", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"rename window to: \")"},
    {"type": "win one"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_name}\" (elate-tmux-id)) \"win one\") (string-search \":win one%\" (buffer-name)))"},
    {"keys": "C-t $", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"rename session to: \")"},
    {"type": "p2"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{session_name}\" (elate-tmux-id)) \"p2\") (seq-every-p (lambda (b) (string-search \":p2:\" (buffer-name b))) (elate-tmux-panes)))"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"type": "set-option -g @elate yes"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (elate-tmux-call \"show-options\" \"-gv\" \"@elate\") \"yes\")"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"type": "no-such-command"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(with-current-buffer \"*Messages*\" (save-excursion (goto-char (point-min)) (let ((case-fold-search nil)) (search-forward \"Command failed: no-such-command: parse error: unknown command: no-such-command\" nil t))))"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"type": "display-message -p elate-one ; display-message elate-two"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(with-current-buffer \"*Messages*\" (save-excursion (goto-char (point-min)) (search-forward \"elate-one\\nelate-two\" nil t)))", "comment": "every block of a compound line"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"type": "# no reply block"},
    {"keys": "RET", "delivery": "events"},
    {"type": "printf 'TY%sPED\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"TYPED\")", "comment": "a line tmux does not answer holds nothing up"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"keys": "RET", "delivery": "events"},
    {"assert": {"eval": "(elate-tmux-attached-p)"}, "comment": "an empty line would make tmux leave control mode"},
    {"keys": "C-t :", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux command: \")"},
    {"type": "list-commands"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (get-buffer-window \"*ghostel-tmux-output*\") (eq (window-buffer (selected-window)) elate-p3) (elate-tmux-sync-p))", "comment": "long output goes to a window of its own and the pane keeps the focus"},
    {"assert": {"eval": "(with-current-buffer \"*ghostel-tmux-output*\" (string-search \"list-commands\" (buffer-string)))"}},
    {"eval": "(progn (delete-other-windows) t)"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},
    {"mouse": "click", "part": "tab-line", "col": 5},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))", "comment": "a tab of the other tmux window"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},
    {"keys": "C-t C-n"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p0) (elate-tmux-sync-p))", "comment": "the next pane is in the other tmux window, already active there"},
    {"keys": "C-t C-p"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},

    {"group": "two windows", "comment": "a pane of another tmux window in a second Emacs window leaves the first one alone"},
    {"eval": "(progn (set-window-buffer (split-window) elate-p0) t)"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{pane_id}\" (elate-tmux-session)) (elate-tmux-id elate-p0))", "comment": "tmux follows the pane shown last"},
    {"wait": "idle"},
    {"assert": {"eval": "(equal (mapcar (function window-buffer) (window-list)) (list elate-p3 elate-p0))"}},
    {"eval": "(progn (delete-other-windows) t)"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},

    {"group": "full-screen program", "comment": "less on the alternate screen, redrawn after a frame resize, and the previous screen back"},
    {"eval": "(with-temp-file \"/tmp/ghostel-tmux-elate-panes-{{variant}}/nums.txt\" (dotimes (i 200) (insert (format \"%d\\n\" (1+ i)))))"},
    {"type": "printf 'BE%sFORE-LESS\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"BEFORE-LESS\")"},
    {"type": "less /tmp/ghostel-tmux-elate-panes-{{variant}}/nums.txt"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{alternate_on}\" (elate-tmux-id)) \"1\") (elate-tmux-rows-p 1))"},
    {"resize": "100x24"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 99) (elate-tmux-sync-p) (elate-tmux-rows-p 1))"},
    {"keys": "q"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{alternate_on}\" (elate-tmux-id)) \"0\")"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"BEFORE-LESS\")"},
    {"assert": {"eval": "(not (elate-tmux-line-p \"2\"))"}},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 119) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "hidden window", "comment": "a frame resize reaches a window not shown; it keeps its prompt and the output it got while hidden"},
    {"eval": "(setq elate-here (current-buffer))"},
    {"eval": "(progn (elate-tmux-call \"send-keys\" \"-t\" (concat (elate-tmux-session) \":+\") \"printf 'HID%sDEN\\\\n' ''\" \"Enter\") t)"},
    {"resize": "100x24"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 99) (elate-tmux-sync-p))"},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (eq (current-buffer) elate-here)) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(and (elate-tmux-line-p \"HIDDEN\") (elate-tmux-prompt-p))"},
    {"keys": "C-t p"},
    {"wait": "until", "pred": "(and (eq (current-buffer) elate-here) (elate-tmux-sync-p))"},
    {"eval": "(progn (elate-tmux-call \"send-keys\" \"-t\" (concat (elate-tmux-session) \":+\") \"printf 'SAME%sSIZE\\\\n' ''\" \"Enter\") t)"},
    {"wait": "until", "pred": "(string-match-p \"^SAMESIZE\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" (concat (elate-tmux-session) \":+\")))"},
    {"wait": "idle"},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (eq (current-buffer) elate-here)) (elate-tmux-line-p \"SAMESIZE\"))", "comment": "no size change to redraw it"},
    {"keys": "C-t p"},
    {"wait": "until", "pred": "(and (eq (current-buffer) elate-here) (elate-tmux-sync-p))"},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 119) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "scrollback", "comment": "history beyond the screen, copy mode and a backward search"},
    {"type": "sh -c 'seq 1 300 | sed s/^/row-/'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"row-300\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"row-1\")"}},
    {"keys": "C-c C-t"},
    {"assert": {"eval": "(eq ghostel--input-mode (quote copy))"}},
    {"keys": "C-M-r", "delivery": "events"},
    {"type": "row-1$"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (eq ghostel--input-mode (quote copy)) (equal (string-trim (thing-at-point (quote line) t)) \"row-1\"))"},
    {"keys": "q"},
    {"assert": {"eval": "(eq ghostel--input-mode (quote semi-char))"}},
    {"type": "printf 'AF%sTER-COPY\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"AFTER-COPY\")"},

    {"group": "second client", "comment": "changes made by another tmux client show up"},
    {"eval": "(elate-tmux-call \"split-window\" \"-t\" (elate-tmux-id))"},
    {"wait": "until", "pred": "(= 5 (length (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-p0 elate-p1 elate-p2 elate-p3))) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"eval": "(setq elate-p4 (current-buffer))"},
    {"eval": "(elate-tmux-call \"send-keys\" \"-t\" (elate-tmux-id) \"printf 'EX%sT1\\\\n' ''\" \"Enter\")"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"EXT1\")"},
    {"eval": "(elate-tmux-call \"rename-window\" \"-t\" (elate-tmux-id) \"extname\")"},
    {"wait": "until", "pred": "(string-search \":extname%\" (buffer-name))"},
    {"eval": "(elate-tmux-call \"kill-pane\" \"-t\" (elate-tmux-id))"},
    {"wait": "until", "pred": "(and (eq (elate-tmux-shown) elate-p3) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(= 4 (length (elate-tmux-panes)))"}},
    {"assert": {"eval": "(not (buffer-live-p elate-p4))"}},
    {"eval": "(elate-tmux-call \"kill-window\" \"-t\" (elate-tmux-id))"},
    {"wait": "until", "pred": "(and (memq (elate-tmux-shown) (list elate-p0 elate-p1 elate-p2)) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(= 3 (length (elate-tmux-panes)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (mapcar (function elate-tmux-id) (list elate-p0 elate-p1 elate-p2)))"}},

    {"group": "closing", "comment": "a pane, a window, and a pane buffer killed in Emacs"},
    {"eval": "(setq elate-cur (current-buffer))"},
    {"keys": "C-t x"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-cur))) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(= 2 (length (elate-tmux-panes)))"}},
    {"assert": {"eval": "(not (buffer-live-p elate-cur))"}},
    {"keys": "C-t c"},
    {"wait": "until", "pred": "(= 3 (length (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (memq (current-buffer) (list elate-p0 elate-p1 elate-p2))) (elate-tmux-sync-p))"},
    {"eval": "(setq elate-cur (current-buffer))"},
    {"keys": "C-t &"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (buffer-live-p elate-cur)) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(= 2 (length (elate-tmux-panes)))"}},
    {"eval": "(setq elate-cur (current-buffer))"},
    {"keys": "C-x k RET"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (not (eq (current-buffer) elate-cur)))"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_panes}\" (elate-tmux-id)) \"2\")"}, "comment": "the pane itself lives on"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'KI%sLLED-OK\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"KILLED-OK\")"},

    {"group": "help", "comment": "C-t ? describes the prefix map"},
    {"keys": "C-t ?"},
    {"wait": "until", "pred": "(get-buffer-window \"*Help*\")"},
    {"assert": {"buffer_contains": "ghostel-tmux--prefix-split-h", "buffer": "*Help*"}},
    {"keys": "C-x 1"},
    {"wait": "until", "pred": "(= 1 (length (window-list)))"},

    {"group": "leave", "comment": "C-t d detaches; the session stays on the server"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (null (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-call \"list-sessions\" \"-F\" \"#{session_name} #{session_attached}\") \"p2 0\")"},
    {"assert": {"eval": "{{left}}"}},

    {"group": "cleanup", "comment": "no server is left"},
    {"assert": {"eval": "(elate-tmux-cleanup)"}}
  ]
}
