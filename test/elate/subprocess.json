{
  "name": "subprocess",
  "comment": "The M-x commands that run their own `tmux -CC': attach, new, detach, capture, and the ways such a client ends.",
  "session": {
    "ui": "tty",
    "size": "120x36",
    "config": "minimal",
    "env": {"SHELL": "/opt/homebrew/bin/bash"},
    "load": ["lib/ghostel-tmux-setup.el"],
    "eval": [
      "(elate-tmux-init \"subprocess\" \"/opt/homebrew/bin/bash\" t)"
    ]
  },
  "defaults": {"timeout": 20},
  "steps": [
    {"group": "setup", "comment": "three sessions made outside Emacs; d1 has 3000 lines of history, d3 a second window whose active pane is not its first"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d2\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"set-option\" \"-g\" \"history-limit\" \"5000\") (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d1\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"send-keys\" \"-t\" \"d1\" \"sh -c 'seq 1 3000 | sed s/^/hist-/'\" \"Enter\") (elate-tmux-call \"send-keys\" \"-t\" \"d2\" \"printf 'IN%sD2\\\\n' ''\" \"Enter\") (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d3\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"new-window\" \"-t\" \"d3\") (elate-tmux-call \"split-window\" \"-t\" \"d3\") (elate-tmux-call \"select-window\" \"-t\" \"d3:0\") (setq elate-bg (elate-tmux-q \"#{pane_id}\" \"d3:1\")))"},
    {"wait": "until", "pred": "(> (string-to-number (elate-tmux-q \"#{history_size}\" \"d1\")) 2900)"},
    {"wait": "until", "pred": "(string-match-p \"^IND2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"d2\"))"},

    {"group": "attach", "comment": "M-x ghostel-tmux-attach asks for the session and backfills its history"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d1"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d1:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"hist-3000\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"hist-1\")"}},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (list (elate-tmux-id)))"}},
    {"assert": {"eval": "(= 1 (length (elate-tmux-controllers)))"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'AT%sTACH1\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"ATTACH1\")"},

    {"group": "detach", "comment": "C-c C-d ends the client; the pane stays as a snapshot and the session lives on"},
    {"eval": "(setq elate-d1 (current-buffer))"},
    {"keys": "C-c C-d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(with-current-buffer elate-d1 (and buffer-read-only (null ghostel-pty-out-function)))"}},
    {"assert": {"eval": "(eq (window-buffer) elate-d1)"}},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"d1\") \"0\")"},

    {"group": "background window", "comment": "a pane that is already the active one of a window never visited"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d3"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d3:\" (buffer-name)))"},
    {"assert": {"eval": "(not (equal (elate-tmux-id) elate-bg))"}},
    {"assert": {"eval": "(equal (car (last (elate-tmux-tabs))) elate-bg)"}},
    {"keys": "C-c C-p"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-bg) (elate-tmux-sync-p))"},
    {"keys": "C-c C-d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},

    {"group": "new", "comment": "M-x ghostel-tmux-new creates `main', and attaches to it the second time"},
    {"keys": "M-x ghostel-tmux-new RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session name: \")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":main:\" (buffer-name)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"1\")"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'IN%sMAIN\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"INMAIN\")"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"0\")"},
    {"keys": "M-x ghostel-tmux-new RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session name: \")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":main:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"INMAIN\")"},
    {"assert": {"eval": "(equal (elate-tmux-call \"list-sessions\" \"-F\" \"#{session_name}\") \"d1\\nd2\\nd3\\nmain\")"}},
    {"eval": "(setq elate-main (current-buffer))"},

    {"group": "two sessions", "comment": "each tab line lists its own session's panes, and keys go to the session shown"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d2"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d2:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"IND2\")"},
    {"eval": "(setq elate-d2 (current-buffer))"},
    {"assert": {"eval": "(= 2 (length (elate-tmux-controllers)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (list (elate-tmux-id)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs elate-main) (list (elate-tmux-id elate-main)))"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'TO%s-D2\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"TO-D2\")"},
    {"assert": {"eval": "(string-match-p \"^TO-D2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"d2\"))"}},
    {"assert": {"eval": "(not (string-match-p \"^TO-D2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"main\")))"}},

    {"group": "capture", "comment": "M-x ghostel-tmux-capture snapshots a pane without attaching"},
    {"keys": "M-x ghostel-tmux-capture RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux target (e.g. mysession:0.0 or %3): \")"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "d1:0.0"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(string-prefix-p \"*ghostel-tmux-capture:d1:0.0*\" (buffer-name))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"hist-3000\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"hist-1\")"}},
    {"assert": {"eval": "(not (save-excursion (goto-char (point-min)) (re-search-forward \"^ +hist-\" nil t)))"}, "comment": "rows start at column 0"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{session_attached}\" \"d1\") \"0\")"}},
    {"eval": "(progn (kill-buffer (current-buffer)) (delete-other-windows) t)"},

    {"group": "quit paths", "comment": "a killed controller buffer, M-x ghostel-tmux-reset and a killed server each seal the panes"},
    {"eval": "(kill-buffer (buffer-local-value (quote ghostel-tmux--controller-buffer) elate-d2))"},
    {"wait": "until", "pred": "(with-current-buffer elate-d2 (and buffer-read-only (null ghostel-pty-out-function)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"d2\") \"0\")"},
    {"assert": {"eval": "(= 1 (length (elate-tmux-controllers)))"}},
    {"eval": "(progn (switch-to-buffer elate-main) t)"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"keys": "M-x ghostel-tmux-reset RET"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"0\")"},
    {"assert": {"messages_match": "Session reset; pane buffers sealed"}},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d1"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d1:\" (buffer-name)))"},
    {"eval": "(setq elate-d1 (current-buffer))"},
    {"eval": "(elate-tmux-call \"kill-server\")"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(with-current-buffer elate-d1 (and buffer-read-only (null ghostel-pty-out-function)))"}},

    {"group": "no server", "comment": "M-x ghostel-tmux-attach says that there is no session"},
    {"assert": {"eval": "(condition-case err (progn (call-interactively (quote ghostel-tmux-attach)) nil) (user-error (equal (cadr err) \"Ghostel-tmux: No tmux sessions found\")))"}},

    {"group": "cleanup", "comment": "no server is left"},
    {"assert": {"eval": "(elate-tmux-cleanup)"}}
  ]
}
