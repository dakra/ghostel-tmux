{
  "name": "subprocess",
  "comment": "The M-x commands that run their own `tmux -CC': attach, new, detach, capture, and the ways such a client ends, one pane per Emacs window (`ghostel-tmux-split-windows' off), the panes kept as snapshots (`ghostel-tmux-keep-detached-panes' t).",
  "session": {
    "ui": "tty",
    "size": "120x36",
    "config": "minimal",
    "env": {"SHELL": "/opt/homebrew/bin/bash"},
    "load": ["lib/ghostel-tmux-setup.el"],
    "eval": [
      "(elate-tmux-init \"subprocess\" \"/opt/homebrew/bin/bash\" t)",
      "(setq ghostel-tmux-split-windows nil)",
      "(setq ghostel-tmux-keep-detached-panes t)"
    ]
  },
  "defaults": {"timeout": 20},
  "steps": [
    {"group": "setup", "comment": "three sessions made outside Emacs; d1 has 3000 lines of history, d3 a second window whose active pane is not its first"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d2\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"set-option\" \"-g\" \"history-limit\" \"5000\") (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d1\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"send-keys\" \"-t\" \"d1\" \"sh -c 'seq 1 3000 | sed s/^/hist-/'\" \"Enter\") (elate-tmux-call \"send-keys\" \"-t\" \"d2\" \"printf 'IN%sD2\\\\n' ''\" \"Enter\") (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d3\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"new-window\" \"-t\" \"d3\") (elate-tmux-call \"split-window\" \"-t\" \"d3\") (elate-tmux-call \"select-window\" \"-t\" \"d3:0\") (setq elate-bg (elate-tmux-q \"#{pane_id}\" \"d3:1\")))"},
    {"wait": "until", "pred": "(> (string-to-number (elate-tmux-q \"#{history_size}\" \"d1\")) 2900)"},
    {"wait": "until", "pred": "(string-match-p \"^IND2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"d2\"))"},

    {"group": "failed attach", "comment": "tmux's reason reaches the user, at once, and nothing stays behind"},
    {"eval": "(let ((start (float-time))) (ghostel-tmux-attach \"nosuch\") (setq elate-took (- (float-time) start)) t)"},
    {"wait": "until", "pred": "(null (seq-find (lambda (b) (string-prefix-p \" *ghostel-tmux-control:\" (buffer-name b))) (buffer-list)))"},
    {"assert": {"eval": "(< elate-took 2)"}},
    {"assert": {"eval": "(with-current-buffer \"*Messages*\" (save-excursion (goto-char (point-min)) (search-forward \"can't find session\" nil t)))"}},

    {"group": "attach", "comment": "M-x ghostel-tmux-attach asks for the session and backfills its history"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d1"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d1:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"hist-3000\")"},
    {"eval": "(progn (elate-tmux-call \"rename-window\" \"-t\" (elate-tmux-id) \"größe\") t)", "comment": "a name on the wire is UTF-8 bytes"},
    {"wait": "until", "pred": "(string-search \"größe\" (buffer-name))"},
    {"assert": {"eval": "(elate-tmux-line-p \"hist-1\")"}},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (list (elate-tmux-id)))"}},
    {"assert": {"eval": "(= 1 (length (elate-tmux-controllers)))"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'AT%sTACH1\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"ATTACH1\")"},

    {"group": "detach", "comment": "C-t d ends the client; the pane stays as a snapshot, whatever mouse tracking its program had on, and the session lives on"},
    {"eval": "(setq elate-d1 (current-buffer))"},
    {"type": "printf '\\033[?1000h'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(ghostel--mode-enabled ghostel--term 1000)"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(with-current-buffer elate-d1 (and buffer-read-only (null ghostel-pty-out-function)))"}},
    {"assert": {"eval": "(with-current-buffer elate-d1 (not (ghostel--mode-enabled ghostel--term 1000)))"}},
    {"assert": {"eval": "(with-current-buffer elate-d1 (condition-case nil (progn (ghostel-tmux-switch-pane) nil) (user-error t)))"}, "comment": "a snapshot has no sibling panes to pick"},
    {"assert": {"eval": "(eq (window-buffer) elate-d1)"}},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"d1\") \"0\")"},

    {"group": "background window", "comment": "a pane that is already the active one of a window never visited"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d3"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d3:\" (buffer-name)))"},
    {"assert": {"eval": "(not (equal (elate-tmux-id) elate-bg))"}},
    {"assert": {"eval": "(equal (car (last (elate-tmux-tabs))) elate-bg)"}},
    {"keys": "C-t C-p"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-bg) (elate-tmux-sync-p))"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},

    {"group": "running program", "comment": "a full-screen program keeps its screen, cursor and modes across an attach, and leaving it brings back the primary screen"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d6\" \"-x\" \"80\" \"-y\" \"24\" \"printf 'BASE-LINE\\\\n'; printf '\\\\033[?1049h\\\\033[?1000h\\\\033[?1006h\\\\033[?2004h\\\\033[?1h\\\\033[2J\\\\033[1;1HFULL-SCREEN\\\\033[5;10H'; read x; printf '\\\\033[?1049l\\\\033[?1000l\\\\033[?1006l\\\\033[?2004l\\\\033[?1lBACK-AGAIN\\\\n'; sleep 100\") t)"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{alternate_on} #{cursor_y}\" \"d6\") \"1 4\")"},
    {"eval": "(progn (ghostel-tmux-attach \"d6\") t)"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (elate-tmux-line-p \"FULL-SCREEN\"))"},
    {"assert": {"eval": "(and (ghostel--mode-enabled ghostel--term 1049) (ghostel--mode-enabled ghostel--term 1000) (ghostel--mode-enabled ghostel--term 1006) (ghostel--mode-enabled ghostel--term 2004) (ghostel--mode-enabled ghostel--term 1))"}},
    {"assert": {"eval": "(progn (ghostel--redraw-now (current-buffer) t) (equal (cdr ghostel--cursor-pos) 4))"}},
    {"assert": {"eval": "(progn (ghostel--redraw-now (current-buffer) t) (equal (car ghostel--cursor-pos) 9))"}},
    {"eval": "(progn (elate-tmux-call \"send-keys\" \"-t\" \"d6\" \"Enter\") t)"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"BACK-AGAIN\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"BASE-LINE\")"}},
    {"assert": {"eval": "(and (not (ghostel--mode-enabled ghostel--term 1049)) (not (ghostel--mode-enabled ghostel--term 1000)) (not (ghostel--mode-enabled ghostel--term 2004)))"}},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(null (elate-tmux-controllers))"},
    {"eval": "(progn (elate-tmux-call \"kill-session\" \"-t\" \"d6\") t)"},

    {"group": "resized program", "comment": "a program started in a taller pane, with a wrapped row on its alternate screen: tmux keeps the primary screen at its old height, and the cursor comes back to its row"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d7\" \"-x\" (number-to-string (1- (window-body-width))) \"-y\" \"50\" \"seq 1 80; printf '\\\\033[2J\\\\033[HBASE-LINE\\\\n\\\\033[?1049h\\\\033[2J\\\\033[1;1H%0200d\\\\nFULL-SCREEN' 7; read x; printf '\\\\033[?1049lBACK-AGAIN\\\\n'; sleep 100\") t)"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{alternate_on} #{cursor_y}\" \"d7\") \"1 2\")"},
    {"eval": "(progn (elate-tmux-call \"resize-window\" \"-t\" \"d7\" \"-y\" \"24\") (elate-tmux-call \"set-option\" \"-w\" \"-t\" \"d7\" \"window-size\" \"latest\") t)"},
    {"eval": "(progn (ghostel-tmux-attach \"d7\") t)"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (elate-tmux-line-p \"FULL-SCREEN\") (elate-tmux-sync-p))"},
    {"assert": {"eval": "(progn (ghostel--redraw-now (current-buffer) t) (equal ghostel--cursor-pos (cons 11 2)))"}},
    {"eval": "(progn (elate-tmux-call \"send-keys\" \"-t\" \"d7\" \"Enter\") t)"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"BACK-AGAIN\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"BASE-LINE\")"}},
    {"assert": {"eval": "(progn (ghostel--redraw-now (current-buffer) t) (equal (cdr ghostel--cursor-pos) (string-to-number (elate-tmux-q \"#{cursor_y}\" \"d7\"))))"}},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(null (elate-tmux-controllers))"},
    {"eval": "(progn (elate-tmux-call \"kill-session\" \"-t\" \"d7\") t)"},

    {"group": "current window", "comment": "attaching to a session on its second window shows tmux's active pane there, and both windows stay reachable"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d4\" \"-x\" \"100\" \"-y\" \"30\") (elate-tmux-call \"split-window\" \"-t\" \"d4:0\") (elate-tmux-call \"select-pane\" \"-t\" \"d4:0.0\") (elate-tmux-call \"new-window\" \"-t\" \"d4\") (elate-tmux-call \"split-window\" \"-t\" \"d4:1\") (setq elate-cur (elate-tmux-q \"#{pane_id}\" \"d4:1\") elate-w0 (elate-tmux-q \"#{pane_id}\" \"d4:0.0\") elate-w0b (elate-tmux-q \"#{pane_id}\" \"d4:0.1\")))"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d4"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d4:\" (buffer-name)))"},
    {"assert": {"eval": "(equal (elate-tmux-id) elate-cur)"}},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_index}\" \"d4\") \"1\")"}},
    {"keys": "C-t 0"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-w0) (elate-tmux-sync-p))"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-cur) (elate-tmux-sync-p))"},

    {"group": "hidden zoomed pane", "comment": "a zoomed pane out of view keeps the size tmux gave it, through a new window's rows and a frame resize"},
    {"eval": "(setq elate-zoomed (current-buffer))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" \"d4:1\") \"1\")"},
    {"keys": "C-t 0"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-w0) (elate-tmux-sync-p))"},
    {"eval": "(progn (elate-tmux-call \"new-window\" \"-d\" \"-t\" \"d4\") t)"},
    {"wait": "until", "pred": "(= 5 (length (elate-tmux-panes)))"},
    {"assert": {"eval": "(equal (number-to-string (buffer-local-value (quote ghostel--term-rows) elate-zoomed)) (elate-tmux-q \"#{pane_height}\" elate-cur))"}},
    {"eval": "(progn (elate-tmux-call \"kill-window\" \"-t\" \"d4:2\") t)"},
    {"wait": "until", "pred": "(= 4 (length (elate-tmux-panes)))"},
    {"resize": "100x24"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 99) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(equal (number-to-string (buffer-local-value (quote ghostel--term-rows) elate-zoomed)) (elate-tmux-q \"#{pane_height}\" elate-cur))"},
    {"resize": "120x36"},
    {"wait": "until", "pred": "(and (= ghostel--term-cols 119) (elate-tmux-sync-p))"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-cur) (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},

    {"group": "background pane change", "comment": "another client moving a window we are not on keeps the view and is remembered for the visit; the rename is the marker that the report arrived"},
    {"eval": "(progn (elate-tmux-call \"select-pane\" \"-t\" \"d4:0.1\") (elate-tmux-call \"rename-window\" \"-t\" \"d4:1\" \"mark1\"))"},
    {"wait": "until", "pred": "(string-search \":mark1\" (buffer-name))"},
    {"assert": {"eval": "(equal (elate-tmux-id) elate-cur)"}},
    {"assert": {"eval": "(elate-tmux-sync-p)"}},
    {"keys": "C-t 0"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-w0b) (elate-tmux-sync-p))"},
    {"keys": "C-t 1"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-id) elate-cur) (elate-tmux-sync-p))"},

    {"group": "grouped session", "comment": "a session sharing our windows moves on its own; our session and view stay"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-t\" \"d4\" \"-s\" \"d4g\") (elate-tmux-call \"select-window\" \"-t\" \"d4g:1\") (elate-tmux-call \"select-window\" \"-t\" \"d4g:0\") (elate-tmux-call \"rename-window\" \"-t\" \"d4:1\" \"mark2\"))"},
    {"wait": "until", "pred": "(string-search \":mark2\" (buffer-name))"},
    {"assert": {"eval": "(equal (elate-tmux-id) elate-cur)"}},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_index}\" \"d4\") \"1\")"}},
    {"assert": {"eval": "(elate-tmux-sync-p)"}},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d4\") \"0\") (equal (elate-tmux-id) elate-w0b) (elate-tmux-sync-p))", "comment": "the selection reaches our session, not the grouped one that was active last"},
    {"keys": "C-t C-n"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d4\") \"1\") (elate-tmux-sync-p))"},
    {"eval": "(progn (setq elate-cur (elate-tmux-id)) (elate-tmux-call \"kill-session\" \"-t\" \"d4g\") (sit-for 0.5) t)", "comment": "tmux reports the shared windows as closed"},
    {"assert": {"eval": "(and (equal (elate-tmux-id) elate-cur) (elate-tmux-sync-p))"}},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d4\") \"0\") (elate-tmux-sync-p))"},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d4\") \"1\") (elate-tmux-sync-p))"},

    {"group": "scripted window", "comment": "a window made and split in one go keeps the pane tmux left active, here not the first"},
    {"eval": "(progn (elate-tmux-call \"new-window\" \"-t\" \"d4\" \";\" \"split-window\" \"-t\" \"d4\") t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d4\") \"2\") (elate-tmux-sync-p))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" \"d4\") \"1\")"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{pane_index}\" \"d4\") \"1\")"}},

    {"group": "switch client", "comment": "a client moved to a session of another size shows its active pane, here not the first, and leaves that pane active"},
    {"eval": "(progn (elate-tmux-call \"new-session\" \"-d\" \"-s\" \"d5\" \"-x\" \"70\" \"-y\" \"20\") (elate-tmux-call \"split-window\" \"-t\" \"d5\") (setq elate-cur (elate-tmux-q \"#{pane_id}\" \"d5\")) (ghostel-tmux--cmd \"switch-client -t d5\") t)"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d5:\" (buffer-name)) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(equal (elate-tmux-id) elate-cur)"}},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{pane_id}\" \"d5\") elate-cur)"}},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{session_attached}\" \"d4\") \"0\")"}},

    {"group": "shown pane goes away", "comment": "its Emacs window moves on to the pane tmux picks, also one never shown, and the same when its window closes"},
    {"keys": "C-t x"},
    {"wait": "until", "pred": "(and (= 1 (length (elate-tmux-panes))) (elate-tmux-shown) (elate-tmux-sync-p))"},
    {"eval": "(progn (elate-tmux-call \"new-window\" \"-t\" \"d5\" \";\" \"kill-window\" \"-t\" \"d5:0\") t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{window_index}\" \"d5\") \"1\") (= 1 (length (elate-tmux-panes))) (elate-tmux-shown) (elate-tmux-sync-p))"},

    {"group": "joined pane", "comment": "the pane shown, joined into another window, stays the active one on both sides"},
    {"eval": "(progn (setq elate-dst (elate-tmux-q \"#{window_id}\" \"d5\")) (elate-tmux-call \"new-window\" \"-t\" \"d5\") t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{session_windows}\" \"d5\") \"2\") (elate-tmux-shown) (equal (elate-tmux-id) (elate-tmux-q \"#{pane_id}\" \"d5\")) (elate-tmux-sync-p))"},
    {"eval": "(progn (setq elate-cur (elate-tmux-id)) (elate-tmux-call \"join-pane\" \"-s\" elate-cur \"-t\" elate-dst) t)"},
    {"wait": "until", "pred": "(and (equal (elate-tmux-q \"#{session_windows}\" \"d5\") \"1\") (equal (elate-tmux-q \"#{window_zoomed_flag}\" \"d5\") \"1\") (elate-tmux-shown) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(equal (elate-tmux-id) elate-cur)"}},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{pane_id}\" \"d5\") elate-cur)"}},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"eval": "(progn (elate-tmux-call \"kill-session\" \"-t\" \"d4\") (elate-tmux-call \"kill-session\" \"-t\" \"d5\") t)"},

    {"group": "new", "comment": "M-x ghostel-tmux-new creates `main', and attaches to it the second time"},
    {"keys": "M-x ghostel-tmux-new RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session name: \")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":main:\" (buffer-name)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"1\")"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'IN%sMAIN\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"INMAIN\")"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"0\")"},
    {"keys": "M-x ghostel-tmux-new RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session name: \")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":main:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"INMAIN\")"},
    {"assert": {"eval": "(equal (elate-tmux-call \"list-sessions\" \"-F\" \"#{session_name}\") \"d1\\nd2\\nd3\\nmain\")"}},
    {"eval": "(setq elate-main (current-buffer))"},

    {"group": "two sessions", "comment": "each tab line lists its own session's panes, and keys go to the session shown"},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d2"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d2:\" (buffer-name)))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"IND2\")"},
    {"eval": "(setq elate-d2 (current-buffer))"},
    {"assert": {"eval": "(= 2 (length (elate-tmux-controllers)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs) (list (elate-tmux-id)))"}},
    {"assert": {"eval": "(equal (elate-tmux-tabs elate-main) (list (elate-tmux-id elate-main)))"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "printf 'TO%s-D2\\n' ''"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"TO-D2\")"},
    {"assert": {"eval": "(string-match-p \"^TO-D2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"d2\"))"}},
    {"assert": {"eval": "(not (string-match-p \"^TO-D2$\" (elate-tmux-call \"capture-pane\" \"-p\" \"-t\" \"main\")))"}},

    {"group": "capture", "comment": "M-x ghostel-tmux-capture snapshots a pane without attaching"},
    {"keys": "M-x ghostel-tmux-capture RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux target (e.g. mysession:0.0 or %3): \")"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "d1:0.0"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(string-prefix-p \"*ghostel-tmux-capture:d1:0.0*\" (buffer-name))"},
    {"wait": "until", "pred": "(elate-tmux-line-p \"hist-3000\")"},
    {"assert": {"eval": "(elate-tmux-line-p \"hist-1\")"}},
    {"assert": {"eval": "(not (save-excursion (goto-char (point-min)) (re-search-forward \"^ +hist-\" nil t)))"}, "comment": "rows start at column 0"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{session_attached}\" \"d1\") \"0\")"}},
    {"assert": {"eval": "(not tab-line-mode)"}, "comment": "a capture has no sibling panes"},
    {"eval": "(progn (kill-buffer (current-buffer)) (delete-other-windows) t)"},

    {"group": "quit paths", "comment": "a killed controller buffer, M-x ghostel-tmux-reset and a killed server each seal the panes"},
    {"eval": "(kill-buffer (buffer-local-value (quote ghostel-tmux--controller-buffer) elate-d2))"},
    {"wait": "until", "pred": "(with-current-buffer elate-d2 (and buffer-read-only (null ghostel-pty-out-function)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"d2\") \"0\")"},
    {"assert": {"eval": "(= 1 (length (elate-tmux-controllers)))"}},
    {"eval": "(progn (switch-to-buffer elate-main) t)"},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"keys": "M-x ghostel-tmux-reset RET"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{session_attached}\" \"main\") \"0\")"},
    {"assert": {"messages_match": "Session reset"}},
    {"keys": "M-x ghostel-tmux-attach RET", "delivery": "events"},
    {"wait": "until", "pred": "(elate-tmux-asking-p \"tmux session: \")"},
    {"type": "d1"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (elate-tmux-shown) (string-search \":d1:\" (buffer-name)))"},
    {"eval": "(setq elate-d1 (current-buffer))"},
    {"eval": "(elate-tmux-call \"kill-server\")"},
    {"wait": "until", "pred": "(and (null (elate-tmux-controllers)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(with-current-buffer elate-d1 (and buffer-read-only (null ghostel-pty-out-function)))"}},

    {"group": "no server", "comment": "M-x ghostel-tmux-attach says that there is no session"},
    {"assert": {"eval": "(condition-case err (progn (call-interactively (quote ghostel-tmux-attach)) nil) (user-error (equal (cadr err) \"Ghostel-tmux: No tmux sessions found\")))"}},

    {"group": "cleanup", "comment": "no server is left"},
    {"assert": {"eval": "(elate-tmux-cleanup)"}}
  ]
}
