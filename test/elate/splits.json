{
  "name": "splits",
  "comment": "A tmux window of several panes shown as Emacs window splits (`ghostel-tmux-split-windows'): splitting, selection both ways, zoom, resizing from Emacs and by the frame, a window beside the split, switching tmux windows, closing, leaving. `params' is the takeover from a shell, `new' overrides it with M-x ghostel-tmux-new.",
  "params": {
    "enter": "(ghostel)",
    "ready": "(elate-tmux-prompt-p)",
    "attach": "(ghostel-send-string \"tmux -CC new -s s1\\n\")",
    "left": "(with-current-buffer \"*ghostel*\" (not (string-match-p \"refresh-client\\\\|send-keys\\\\|select-pane\\\\|resize-pane\" (elate-tmux-text))))"
  },
  "variants": {
    "bash-native": {"shell": "/opt/homebrew/bin/bash", "native": "t"},
    "new": {"shell": "/opt/homebrew/bin/bash", "native": "t", "enter": "(ignore)", "ready": "t", "attach": "(ghostel-tmux-new \"s1\")", "left": "(null (elate-tmux-controllers))"}
  },
  "session": {
    "ui": "tty",
    "size": "120x36",
    "config": "minimal",
    "env": {"SHELL": "{{shell}}"},
    "load": ["lib/ghostel-tmux-setup.el"],
    "eval": [
      "(elate-tmux-init \"splits-{{variant}}\" \"{{shell}}\" {{native}})",
      "(ghostel-tmux-takeover-mode 1)"
    ]
  },
  "defaults": {"timeout": 20},
  "steps": [
    {"eval": "{{enter}}"},
    {"wait": "until", "pred": "{{ready}}"},
    {"eval": "{{attach}}", "timeout": 30},
    {"wait": "until", "pred": "(elate-tmux-shown)"},
    {"wait": "until", "pred": "(elate-tmux-sync-p)"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"eval": "(setq elate-p0 (current-buffer))"},

    {"group": "splits", "comment": "a split from Emacs splits the Emacs window, each window the size of its pane; only the top row has a tab line"},
    {"keys": "C-t %"},
    {"wait": "until", "pred": "(elate-tmux-split-p 2)"},
    {"assert": {"eval": "(and (elate-tmux-active-p) (not (eq (current-buffer) elate-p0)))"}},
    {"keys": "C-t \""},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},
    {"assert": {"eval": "(= 3 (length (window-list)))"}},
    {"assert": {"eval": "(equal (mapcar (lambda (w) (window-parameter w 'tab-line-format)) (window-list nil nil (frame-first-window))) '(nil nil none))"}, "comment": "the left pane and the top right one, then the one below"},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"type": "sh -c 'echo PANE$TMUX_PANE'"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(elate-tmux-line-p (concat \"PANE\" (elate-tmux-id)))"},

    {"group": "selection", "comment": "the selected window is tmux's active pane, and tmux's selection moves Emacs's"},
    {"eval": "(select-window (frame-first-window))"},
    {"wait": "until", "pred": "(elate-tmux-active-p)"},
    {"assert": {"eval": "(eq (current-buffer) elate-p0)"}},
    {"keys": "C-t o"},
    {"wait": "until", "pred": "(and (not (eq (window-buffer (selected-window)) elate-p0)) (elate-tmux-active-p))"},
    {"eval": "(elate-tmux-call \"select-pane\" \"-t\" (elate-tmux-id elate-p0))"},
    {"wait": "until", "pred": "(eq (window-buffer (selected-window)) elate-p0)"},

    {"group": "zoom", "comment": "C-t z shows one pane and then all; C-x 1 zooms the pane left"},
    {"keys": "C-t z"},
    {"wait": "until", "pred": "(and (= 1 (length (window-list))) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\")"}},
    {"keys": "C-t z"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},
    {"keys": "C-x 1"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id)) \"1\")"},
    {"wait": "until", "pred": "(and (= 1 (length (window-list))) (elate-tmux-sync-p))"},
    {"keys": "C-t z"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},

    {"group": "resizing", "comment": "a window resized in Emacs resizes its pane; a frame resize reaches all of them"},
    {"eval": "(setq elate-width (window-max-chars-per-line (frame-first-window)))"},
    {"eval": "(adjust-window-trailing-edge (frame-first-window) 6 t)"},
    {"wait": "until", "pred": "(and (elate-tmux-split-p 3) (= (window-max-chars-per-line (frame-first-window)) (+ elate-width 6)))"},
    {"eval": "(set-frame-size (selected-frame) 100 30)"},
    {"wait": "until", "pred": "(and (= 100 (frame-width)) (elate-tmux-split-p 3))"},
    {"eval": "(set-frame-size (selected-frame) 120 36)"},
    {"wait": "until", "pred": "(and (= 120 (frame-width)) (elate-tmux-split-p 3))"},

    {"group": "foreign window", "comment": "a window beside the split keeps its place, also one split off a window of the split"},
    {"eval": "(setq elate-other (split-window (frame-root-window) -30 'right))"},
    {"eval": "(set-window-buffer elate-other (get-buffer-create \"*scratch*\"))"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},
    {"eval": "(setq elate-inner (split-window (frame-first-window) nil 'below))"},
    {"eval": "(set-window-buffer elate-inner (get-buffer-create \"*Messages*\"))"},
    {"wait": "until", "pred": "(and (elate-tmux-split-p 3) (window-live-p elate-inner) (not (memq elate-inner (elate-tmux-split-windows))))"},
    {"assert": {"eval": "(and (window-live-p elate-other) (= 30 (window-total-width elate-other)))"}},
    {"eval": "(progn (delete-window elate-inner) (delete-window elate-other) t)"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},
    {"eval": "(select-window (car (last (elate-tmux-split-windows))))"},
    {"keys": "C-x 3", "comment": "a window split off the last window of the split"},
    {"wait": "until", "pred": "(and (elate-tmux-split-p 3) (seq-every-p (lambda (w) (>= (window-max-chars-per-line w) 10)) (elate-tmux-split-windows)))"},
    {"eval": "(delete-other-windows (car (elate-tmux-split-windows)))", "comment": "C-x 1 zooms that pane"},
    {"wait": "until", "pred": "(equal (elate-tmux-q \"#{window_zoomed_flag}\" (elate-tmux-id (window-buffer (selected-window)))) \"1\")"},
    {"keys": "C-t z"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},

    {"group": "windows", "comment": "another tmux window takes the place of the split, and the split comes back"},
    {"eval": "(select-window (frame-first-window))"},
    {"keys": "C-t c"},
    {"wait": "until", "pred": "(and (= 1 (length (window-list))) (= 4 (length (elate-tmux-panes))) (elate-tmux-sync-p))"},
    {"assert": {"eval": "(elate-tmux-no-split-p)"}},
    {"wait": "until", "pred": "(elate-tmux-prompt-p)"},
    {"keys": "C-t p"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},
    {"keys": "C-t n"},
    {"wait": "until", "pred": "(and (= 1 (length (window-list))) (elate-tmux-sync-p))"},
    {"eval": "(with-current-buffer (buffer-local-value 'ghostel-tmux--controller-buffer (current-buffer)) (ghostel-tmux--show-tmux-window (buffer-local-value 'ghostel-tmux--window-id elate-p0) (selected-window)))", "comment": "the tab of the first window"},
    {"wait": "until", "pred": "(elate-tmux-split-p 3)"},

    {"group": "closing", "comment": "a killed pane leaves the others split"},
    {"eval": "(select-window (frame-first-window))"},
    {"keys": "C-t x"},
    {"wait": "until", "pred": "(elate-tmux-split-p 2)"},
    {"wait": "until", "pred": "(= 3 (length (elate-tmux-panes)))"},

    {"group": "leave", "comment": "C-t d detaches; no window is left part of a split"},
    {"keys": "C-t d"},
    {"wait": "until", "pred": "(and (not (elate-tmux-attached-p)) (null (elate-tmux-panes)))"},
    {"assert": {"eval": "(elate-tmux-no-split-p)"}},
    {"assert": {"eval": "{{left}}"}},

    {"group": "cleanup", "comment": "no server is left"},
    {"assert": {"eval": "(elate-tmux-cleanup)"}}
  ]
}
